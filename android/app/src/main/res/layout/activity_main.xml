<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen column: week chart uses layout_weight to eat leftover height so
     the footer sits on the bottom with no empty gap and no scrollbar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootColumn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp"
    android:background="#121212">

    <!-- Title + settings gear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/Widget.GRLD.Button.Nav"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/summaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B0B0B0"
        android:textSize="15sp" />

    <!-- Main-app multi-segment bar (thicker than notif/widget; vertical-week-bar scale) -->
    <FrameLayout
        android:id="@+id/usageBarTrack"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="14dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/usageBarImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/barLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#888888"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/categories"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="13sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/productsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="6dp"
        app:singleLine="false" />

    <!-- Daily chart header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/daily_use"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnWeekPrev"
            style="@style/Widget.GRLD.Button.Nav"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:contentDescription="@string/week_prev"
            android:src="@drawable/ic_arrow_left"
            android:scaleType="centerInside"
            android:padding="6dp" />

        <TextView
            android:id="@+id/weekLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnWeekNext"
            style="@style/Widget.GRLD.Button.Nav"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:contentDescription="@string/week_next"
            android:src="@drawable/ic_arrow_right"
            android:scaleType="centerInside"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Flexible chart: fills ALL leftover vertical space so footer sits at bottom -->
    <com.blankspeaker.grld.WeekChartView
        android:id="@+id/weekChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:minHeight="100dp" />

    <!-- Shown when a mid-week reset splits a day (black = Before Reset) -->
    <LinearLayout
        android:id="@+id/weekChartLegend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/weekChartLegendDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/weekChartLegendLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/week_legend_prev_reset"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_horizontal"
        android:textColor="#888888"
        android:textSize="12sp" />

    <!-- Primary actions: side-by-side, compact, thin outline -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnRefresh"
            style="@style/Widget.GRLD.Button.Dual"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/refresh" />

        <Button
            android:id="@+id/btnOpenGrok"
            style="@style/Widget.GRLD.Button.Dual"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/open_grok_usage_short" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDonate"
        style="@style/Widget.GRLD.Button.Compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/donate" />

    <Button
        android:id="@+id/btnSubscribe"
        style="@style/Widget.GRLD.Button.Compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/subscribe_x" />

    <TextView
        android:id="@+id/footerCredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/footer_credit"
        android:textColor="#888888"
        android:textSize="12sp"
        android:gravity="center_horizontal" />
</LinearLayout>
